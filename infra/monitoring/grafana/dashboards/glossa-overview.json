{
  "title": "Glossa Platform Overview",
  "uid": "glossa-overview",
  "version": 1,
  "schemaVersion": 38,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Translation Latency P95 (seconds)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(glossa_translation_latency_seconds_bucket[5m])) by (le, mode))",
          "legendFormat": "{{mode}} P95"
        }
      ]
    },
    {
      "id": 2,
      "title": "Active WebSocket Connections",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(glossa_active_websocket_connections)",
          "legendFormat": "Active WS"
        }
      ]
    },
    {
      "id": 3,
      "title": "Request Rate (rps)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(glossa_requests_total[1m])) by (service)",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Model Inference Latency P99 (seconds)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(glossa_model_inference_latency_seconds_bucket[5m])) by (le, service, model))",
          "legendFormat": "{{service}}/{{model}} P99"
        }
      ]
    },
    {
      "id": 5,
      "title": "Error Rate",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(glossa_requests_total{status_code=~\"5..\"}[5m])) by (service) / sum(rate(glossa_requests_total[5m])) by (service)",
          "legendFormat": "{{service}} error rate"
        }
      ]
    },
    {
      "id": 6,
      "title": "Redis Stream Lag",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "glossa_redis_stream_lag",
          "legendFormat": "{{stream}}"
        }
      ]
    }
  ]
}
