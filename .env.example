# ============================================================
# Glossa RSL Translation Platform — Environment Configuration
# ============================================================
# Copy to .env and fill in values. NEVER commit .env to git.

# --- Runtime ---
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                  # json | text

# --- API Gateway ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_WORKERS=1
GATEWAY_SECRET_KEY=change-me-in-production-use-secrets-manager
GATEWAY_CORS_ORIGINS=["http://localhost:3000"]
GATEWAY_MAX_CONNECTIONS=1000
GATEWAY_RATE_LIMIT_RPM=60

# --- Redis ---
REDIS_URL=redis://redis:6379/0
REDIS_STREAM_MAX_LEN=10000
REDIS_CONSUMER_GROUP=glossa-consumers

# --- CV Service ---
CV_SERVICE_URL=http://cv-service:8001
CV_MODEL_BACKEND=onnx              # onnx | openvino
CV_MODEL_PATH=/models/gesture_classifier.onnx
CV_DEVICE=CPU                      # CPU | GPU | AUTO
CV_MAX_BATCH_SIZE=4
CV_MEDIAPIPE_MODEL_COMPLEXITY=1    # 0 | 1 | 2

# --- ASR Service ---
ASR_SERVICE_URL=http://asr-service:8002
ASR_MODEL_SIZE=base                # tiny | base | small | medium | large-v3
ASR_DEVICE=cpu                     # cpu | cuda
ASR_COMPUTE_TYPE=int8              # int8 | float16 | float32
ASR_LANGUAGE=ru
ASR_BEAM_SIZE=5
ASR_VAD_FILTER=true

# --- NLP Service ---
NLP_SERVICE_URL=http://nlp-service:8003
NLP_MODEL_PATH=/models/Qwen2-1.5B-Instruct
NLP_DEVICE=cpu                     # cpu | cuda | mps
NLP_MAX_NEW_TOKENS=512
NLP_TEMPERATURE=0.1
NLP_TOP_P=0.9
NLP_CONTEXT_WINDOW=4096

# --- RAG ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=rsl_glossary
QDRANT_EMBEDDING_MODEL=BAAI/bge-m3
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.7

# --- TTS Service ---
TTS_SERVICE_URL=http://tts-service:8004
TTS_MODEL=silero_tts
TTS_SPEAKER=aidar                  # aidar | baya | kseniya | xenia
TTS_LANGUAGE=ru
TTS_SAMPLE_RATE=24000
TTS_DEVICE=cpu

# --- MAX Adapter ---
MAX_ADAPTER_URL=http://max-adapter:8005
MAX_BOT_TOKEN=                     # Required: MAX Messenger bot token
MAX_WEBHOOK_URL=                   # Public HTTPS URL for webhook subscription, e.g. https://glossa.ai/api/v1/webhook
MAX_WEBHOOK_SECRET=                # HMAC-SHA256 secret for webhook signature verification
MAX_PIPELINE_TIMEOUT=30.0
MAX_BATCH_SIZE=1

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=glossa
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
PROMETHEUS_PORT=9090
JAEGER_AGENT_HOST=jaeger
LOKI_URL=http://loki:3100           # Loki log aggregation endpoint

# --- Grafana ---
GRAFANA_PASSWORD=change-me-in-production
GRAFANA_SMTP_ENABLED=false
GRAFANA_SMTP_HOST=                  # e.g. smtp.gmail.com:587

# --- MLflow ---
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=glossa-production

# --- Backup & Storage ---
BACKUP_DIR=/opt/glossa/backups
BACKUP_RETENTION_DAYS=7
S3_BACKUP_BUCKET=                   # e.g. my-bucket (leave empty to skip S3 upload)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1

# --- DVC ---
DVC_REMOTE_URL=s3://your-bucket/glossa-dvc

# --- Domain (production) ---
DOMAIN=glossa.ai
