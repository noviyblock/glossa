# ================================================================
# Glossa RSL Translation Platform — Environment Configuration
# ================================================================
# cp .env.example .env   then fill in secrets.
# NEVER commit .env to git.

# ── Runtime ──────────────────────────────────────────────────────
ENVIRONMENT=development          # development | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── API Gateway ──────────────────────────────────────────────────
GATEWAY_PORT=8000
SESSION_TTL=300                  # WebSocket session expiry, seconds
HTTP_TIMEOUT=30                  # Downstream service timeout, seconds

# Internal service URLs (used by api-gateway to call other services)
CV_SERVICE_URL=http://cv-service:8001
ASR_SERVICE_URL=http://asr-service:8002
NLP_SERVICE_URL=http://nlp-service:8003
TTS_SERVICE_URL=http://tts-service:8004

# ── CV Service ───────────────────────────────────────────────────
CV_SERVICE_PORT=8001

# Model files (mounted from ./models at /models inside container)
ONNX_MOBILE_PATH=/models/gesture_classifier_mobile.onnx
OV_XML_PATH=/models/stgcn_topk_int8/stgcn_topk_int8.xml
NORM_STATS_PATH=/models/norm_stats.npz

# Dataset index (mounted from ./data at /data inside container)
CLASS_MAP_PATH=/data/idx_to_class.json

# Sliding window parameters -- only consumed by the legacy /ws streaming
# endpoint; the live /process_frame path uses GESTURE_* instead. Kept at
# 64/5 to match the trained model's window size (docker-compose.yml
# hardcodes the same values for cv-service, overriding whatever's here --
# these were previously 32/15, stale relative to the actual model; fixed
# to avoid confusion even though the override made it harmless in practice).
WINDOW_SIZE=64
WINDOW_STRIDE=5
CONF_THRESHOLD=0.7

# ── ASR Service ──────────────────────────────────────────────────
ASR_SERVICE_PORT=8002
WHISPER_MODEL=base               # tiny | base | small | medium | large-v3
DEVICE=cpu                       # cpu | cuda
COMPUTE_TYPE=int8                # int8 | float16 | float32
LANGUAGE=ru
BEAM_SIZE=5
VAD_FILTER=true
WHISPER_CACHE_DIR=/models/whisper_cache

# ── NLP Service ──────────────────────────────────────────────────
NLP_SERVICE_PORT=8003
MODEL_PATH=/models/qwen2_merged_qwen2_1.5b
MAX_NEW_TOKENS=128
CACHE_SIZE=500                   # LRU cache for repeated translations

# ── TTS Service ──────────────────────────────────────────────────
TTS_SERVICE_PORT=8004
SILERO_REPO=snakers4/silero-models
DEFAULT_SPEAKER=xenia            # aidar | baya | kseniya | xenia | random
SAMPLE_RATE=24000
TORCH_HOME=/models/torch_cache   # Silero model cache

# ── Observability ────────────────────────────────────────────────
GRAFANA_PASSWORD=change-me-in-production
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=glossa

# ── DVC / DagsHub ────────────────────────────────────────────────
# Credentials go in .dvc/config.local (gitignored), not here.
# Run: dvc remote modify origin --local access_key_id <key>
#      dvc remote modify origin --local secret_access_key <secret>

# ── Production only ──────────────────────────────────────────────
DOMAIN=localhost
